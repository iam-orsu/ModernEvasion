%% Modern Evasion - Book Template
%% Inspired by No Starch Press typography and layout
%% Uses IBM Plex Serif (body), IBM Plex Sans (headings), IBM Plex Mono (code)

\documentclass[10pt,twoside,openright]{book}

%% ─── Core packages ────────────────────────────────────────────────────────────
\usepackage{fontspec}
\usepackage{geometry}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{titletoc}
\usepackage{tocloft}
\usepackage{listings}
\usepackage{mdframed}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{microtype}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{calc}
\usepackage{etoolbox}
\usepackage{setspace}
\usepackage{parskip}
\usepackage{needspace}
\usepackage{caption}
\usepackage{subcaption}
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{upquote}
\usepackage{csquotes}

%% ─── Page geometry ────────────────────────────────────────────────────────────
\geometry{
  papersize={7in,9in},
  top=0.85in,
  bottom=0.85in,
  inner=0.85in,
  outer=0.85in,
  headsep=0.25in,
  footskip=0.35in,
  headheight=30pt,
  includehead,
  includefoot
}

%% ─── Color palette (No Starch inspired) ──────────────────────────────────────
\definecolor{nsprimary}{HTML}{1A3A5C}      %% deep navy - chapter numbers, headings
\definecolor{nsaccent}{HTML}{C0392B}       %% deep red - callouts, inline code tint
\definecolor{nscode}{HTML}{F6F8FA}         %% near-white - code block background
\definecolor{nscodeborder}{HTML}{D1D5DA}   %% light gray - code block border
\definecolor{nsnote}{HTML}{EBF4FF}         %% pale blue - note box background
\definecolor{nsnoteborder}{HTML}{2980B9}   %% blue - note box left bar
\definecolor{nswarning}{HTML}{FEF9E7}      %% pale yellow - warning box background
\definecolor{nswarningborder}{HTML}{E67E22}%% orange - warning box left bar
\definecolor{nsrule}{HTML}{2E86AB}         %% chapter rule color
\definecolor{nslightgray}{HTML}{888888}    %% light text for headers/footers
\definecolor{nsinline}{HTML}{E74C3C}       %% inline code text color

%% ─── Fonts ────────────────────────────────────────────────────────────────────
\setmainfont{IBM Plex Serif}[
  Path           = /usr/share/fonts/truetype/ibm-plex/,
  UprightFont    = IBMPlexSerif-Regular.ttf,
  BoldFont       = IBMPlexSerif-SemiBold.ttf,
  ItalicFont     = IBMPlexSerif-Italic.ttf,
  BoldItalicFont = IBMPlexSerif-SemiBoldItalic.ttf,
  Ligatures      = TeX,
  Numbers        = OldStyle
]
\setsansfont{IBM Plex Sans}[
  Path           = /usr/share/fonts/truetype/ibm-plex/,
  UprightFont    = IBMPlexSans-Regular.ttf,
  BoldFont       = IBMPlexSans-SemiBold.ttf,
  ItalicFont     = IBMPlexSans-Italic.ttf,
  BoldItalicFont = IBMPlexSans-SemiBoldItalic.ttf,
  Ligatures      = TeX
]
\setmonofont{IBM Plex Mono}[
  Path           = /usr/share/fonts/truetype/ibm-plex/,
  UprightFont    = IBMPlexMono-Regular.ttf,
  BoldFont       = IBMPlexMono-SemiBold.ttf,
  ItalicFont     = IBMPlexMono-Italic.ttf,
  BoldItalicFont = IBMPlexMono-SemiBoldItalic.ttf,
  Scale          = 0.88
]

%% ─── Paragraph spacing ────────────────────────────────────────────────────────
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 2pt minus 1pt}
\setlength{\emergencystretch}{3em}

%% ─── Hyperlinks ───────────────────────────────────────────────────────────────
\hypersetup{
  hidelinks         = true,
  pdfborder         = {0 0 0},
  breaklinks        = true,
  pdftitle          = {$title$},
  pdfauthor         = {$author$},
  bookmarksnumbered = true,
  bookmarksopen     = true
}

%% Uppercase color aliases (book class MakeUppercase uppercases color name args)
\colorlet{NSPRIMARY}{nsprimary}
\colorlet{NSACCENT}{nsaccent}
\colorlet{NSCODE}{nscode}
\colorlet{NSCODEBORDER}{nscodeborder}
\colorlet{NSNOTE}{nsnote}
\colorlet{NSNOTEBORDER}{nsnoteborder}
\colorlet{NSWARNING}{nswarning}
\colorlet{NSWARNINGBORDER}{nswarningborder}
\colorlet{NSRULE}{nsrule}
\colorlet{NSLIGHTGRAY}{nslightgray}
\colorlet{NSINLINE}{nsinline}

%% Strip font/color commands from PDF bookmarks (hyperref conflict fix)
\pdfstringdefDisableCommands{%
  \let\color\@gobble%
  \let\sffamily\relax%
  \let\bfseries\relax%
  \let\itshape\relax%
  \let\normalfont\relax%
  \let\Large\relax%
  \let\large\relax%
  \let\small\relax%
  \let\tiny\relax%
}

%% ─── Section heading styles ──────────────────────────────────────────────────
%% Part
\titleformat{\part}[display]
  {\sffamily\Huge\bfseries\color{nsprimary}}
  {\partname\ \thepart}
  {20pt}
  {\Huge}

%% Safe color command for headings (strips cleanly from PDF bookmarks)
\newcommand{\hcolor}[1]{\texorpdfstring{\color{#1}}{}}

%% Chapter - No Starch style: rule across page, huge number, title below
\titleformat{\chapter}[display]
  {\sffamily\huge\bfseries\hcolor{nsprimary}}
  {%
    \hcolor{nsrule}\rule{\textwidth}{2pt}\\[6pt]
    \normalfont\sffamily\Large\hcolor{nslightgray}Chapter \thechapter%
  }
  {12pt}
  {\huge\bfseries\hcolor{nsprimary}}
  [\vspace{4pt}\hcolor{nsrule}\rule{\textwidth}{0.6pt}]

\titlespacing*{\chapter}{0pt}{-20pt}{32pt}

%% Section
\titleformat{\section}
  {\sffamily\large\bfseries\hcolor{nsprimary}}
  {\hcolor{nsprimary}\thesection}
  {0.75em}
  {}
  []

\titlespacing*{\section}{0pt}{18pt plus 4pt minus 2pt}{8pt plus 2pt}

%% Subsection
\titleformat{\subsection}
  {\sffamily\normalsize\bfseries\hcolor{nsprimary}}
  {\hcolor{nsprimary}\thesubsection}
  {0.6em}
  {}

\titlespacing*{\subsection}{0pt}{12pt plus 3pt minus 1pt}{4pt plus 1pt}

%% Subsubsection
\titleformat{\subsubsection}
  {\sffamily\small\bfseries}
  {}
  {0pt}
  {}

\titlespacing*{\subsubsection}{0pt}{10pt plus 2pt}{4pt}

%% ─── Table of contents ────────────────────────────────────────────────────────
\renewcommand{\contentsname}{\sffamily\texorpdfstring{\color{nsprimary}}{}Contents}
\setlength{\cftbeforechapskip}{8pt}
\renewcommand{\cftchapfont}{\sffamily\bfseries}
\renewcommand{\cftchappagefont}{\sffamily\bfseries}
\renewcommand{\cftsecfont}{\sffamily\small}
\renewcommand{\cftsecpagefont}{\sffamily\small}
\setlength{\cftsecindent}{1.5em}
\renewcommand{\cftdotsep}{3}

%% ─── Headers and footers ─────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\sffamily\color{nslightgray}\textit{$title$}}
\fancyhead[RO]{\small\sffamily\color{nslightgray}\textit{\leftmark}}
\fancyfoot[LE,RO]{\small\sffamily\color{nslightgray}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{nscodeborder}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[LE,RO]{\small\sffamily\color{nslightgray}\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

%% ─── Code listings ───────────────────────────────────────────────────────────
\lstset{
  basicstyle       = \footnotesize\ttfamily\linespread{1.1}\selectfont,
  backgroundcolor  = \color{nscode},
  frame            = single,
  framesep         = 4pt,
  rulecolor        = \color{nscodeborder},
  breaklines       = true,
  breakatwhitespace= true,
  breakindent      = 2em,
  columns          = fullflexible,
  keepspaces       = true,
  showstringspaces = false,
  tabsize          = 4,
  numbers          = left,
  numberstyle      = \tiny\sffamily\color{nslightgray},
  numbersep        = 8pt,
  xleftmargin      = 20pt,
  xrightmargin     = 4pt,
  aboveskip        = 12pt,
  belowskip        = 8pt,
  keywordstyle     = \bfseries\color{nsprimary},
  stringstyle      = \color{nsaccent},
  commentstyle     = \itshape\color{nslightgray},
  identifierstyle  = \color{black},
  literate         = {->}{{\textcolor{nsprimary}{->}}}2
                     {=>}{{\textcolor{nsprimary}{=>}}}2,
  language         = [Sharp]C,
  morekeywords     = {var,string,int,bool,byte,uint,ulong,long,unsafe,fixed,
                      stackalloc,sizeof,typeof,nameof,using,namespace,class,
                      static,void,public,private,protected,internal,readonly,
                      const,new,return,if,else,for,foreach,while,do,switch,
                      case,break,continue,try,catch,finally,throw,null,true,
                      false,ref,out,in,params,delegate,event,abstract,virtual,
                      override,sealed,partial,async,await,yield},
}

%% Generic listing for shell/bash/plaintext
\lstdefinestyle{shell}{
  basicstyle       = \footnotesize\ttfamily,
  backgroundcolor  = \color{nsprimary!8},
  frame            = single,
  rulecolor        = \color{nsprimary!30},
  numbers          = none,
  xleftmargin      = 8pt,
  xrightmargin     = 4pt,
  aboveskip        = 10pt,
  belowskip        = 6pt,
  breaklines       = true,
  keywordstyle     = \color{black},
  commentstyle     = \color{nslightgray},
  stringstyle      = \color{black},
}

%% ─── Callout boxes ───────────────────────────────────────────────────────────
\mdfdefinestyle{notestyle}{
  backgroundcolor  = nsnote,
  linecolor        = nsnoteborder,
  linewidth        = 3pt,
  topline          = false,
  rightline        = false,
  bottomline       = false,
  leftline         = true,
  innerleftmargin  = 10pt,
  innerrightmargin = 10pt,
  innertopmargin   = 8pt,
  innerbottommargin= 8pt,
  skipabove        = 10pt,
  skipbelow        = 8pt,
}

\mdfdefinestyle{warningstyle}{
  backgroundcolor  = nswarning,
  linecolor        = nswarningborder,
  linewidth        = 3pt,
  topline          = false,
  rightline        = false,
  bottomline       = false,
  leftline         = true,
  innerleftmargin  = 10pt,
  innerrightmargin = 10pt,
  innertopmargin   = 8pt,
  innerbottommargin= 8pt,
  skipabove        = 10pt,
  skipbelow        = 8pt,
}

\newenvironment{notebox}[1][Note]{%
  \begin{mdframed}[style=notestyle]%
  \noindent{\sffamily\bfseries\small\color{nsnoteborder}#1}\par\smallskip%
  \small%
}{\end{mdframed}}

\newenvironment{warnbox}[1][Warning]{%
  \begin{mdframed}[style=warningstyle]%
  \noindent{\sffamily\bfseries\small\color{nswarningborder}#1}\par\smallskip%
  \small%
}{\end{mdframed}}

%% ─── Inline code styling ─────────────────────────────────────────────────────
\let\oldtexttt\texttt
\renewcommand{\texttt}[1]{%
  {\ttfamily\small\color{nsprimary}#1}%
}

%% ─── Table styling ───────────────────────────────────────────────────────────
\renewcommand{\arraystretch}{1.3}
\setlength{\tabcolsep}{6pt}

%% ─── List styling ────────────────────────────────────────────────────────────
\setlist[itemize]{
  leftmargin = 1.5em,
  topsep     = 4pt,
  itemsep    = 2pt,
  parsep     = 0pt
}
\setlist[enumerate]{
  leftmargin = 1.75em,
  topsep     = 4pt,
  itemsep    = 2pt,
  parsep     = 0pt
}
\setlist[description]{
  font       = \sffamily\bfseries,
  leftmargin = 1.5em,
  topsep     = 4pt,
  itemsep    = 2pt
}

%% ─── Pandoc syntax highlighting support ─────────────────────────────────────
$if(highlighting-macros)$
$highlighting-macros$
$endif$

%% Override Shaded background to match our code style
\renewenvironment{Shaded}{\begin{mdframed}[
  backgroundcolor=nscode,
  linecolor=nscodeborder,
  linewidth=0.8pt,
  innerleftmargin=8pt,
  innerrightmargin=8pt,
  innertopmargin=6pt,
  innerbottommargin=6pt,
  skipabove=10pt,
  skipbelow=6pt
]}{\end{mdframed}}

%% ─── Providecommand fallbacks ────────────────────────────────────────────────
\providecommand{\tightlist}{%
  \setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}}

\providecommand{\pandocbounded}[1]{#1}

%% ─── Title page ───────────────────────────────────────────────────────────────
\newcommand{\maketitlepage}{%
  \thispagestyle{empty}%
  \begin{titlepage}
    \vspace*{1.2in}
    {\color{nsrule}\rule{\textwidth}{3pt}}\par
    \vspace{16pt}
    {\sffamily\fontsize{36}{40}\selectfont\bfseries\color{nsprimary}$title$}\par
    \vspace{12pt}
    {\color{nsrule}\rule{\textwidth}{1pt}}\par
    \vspace{14pt}
    $if(subtitle)$
    {\sffamily\Large\color{nslightgray}$subtitle$}\par
    \vspace{40pt}
    $endif$
    \vfill
    {\sffamily\large\bfseries\color{nsprimary}$author$}\par
    \vspace{6pt}
    {\sffamily\normalsize\color{nslightgray}$date$}\par
    \vspace{0.4in}
    {\color{nsrule}\rule{\textwidth}{2pt}}
  \end{titlepage}
  \cleardoublepage
}

%% ─── Begin document ──────────────────────────────────────────────────────────
\begin{document}

\frontmatter
\maketitlepage

$if(toc)$
\tableofcontents
\cleardoublepage
$endif$

\mainmatter

$body$

\end{document}
