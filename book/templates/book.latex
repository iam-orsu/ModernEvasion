%% Modern Evasion - Book Template v2
%% IBM Plex Serif (body), IBM Plex Sans (headings), IBM Plex Mono (code)

\documentclass[10pt,oneside]{book}

%% ─── Core packages ────────────────────────────────────────────────────────────
\usepackage{fontspec}
\usepackage{geometry}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{tocloft}
\usepackage{mdframed}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{microtype}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{calc}
\usepackage{etoolbox}
\usepackage{parskip}
\usepackage{caption}
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{upquote}
\usepackage{fvextra}
\usepackage{framed}

%% ─── Page geometry ────────────────────────────────────────────────────────────
\geometry{
  letterpaper,
  top=1.1in,
  bottom=1.0in,
  left=1.25in,
  right=1.25in,
  headsep=0.3in,
  footskip=0.4in,
  headheight=32pt
}

%% ─── Color palette ────────────────────────────────────────────────────────────
\definecolor{chapblue}{HTML}{1B3A6B}      %% deep navy - chapters, headings
\definecolor{accentred}{HTML}{B83232}     %% deep red - callouts, code keywords
\definecolor{codebg}{HTML}{F4F6F8}        %% very light blue-gray code background
\definecolor{codeborder}{HTML}{C8D0D8}    %% code block border
\definecolor{codeaccent}{HTML}{1B3A6B}    %% code keyword color
\definecolor{notebg}{HTML}{EDF4FB}        %% note box background
\definecolor{notebar}{HTML}{2980B9}       %% note left bar
\definecolor{warnbg}{HTML}{FEF3E6}        %% warning background
\definecolor{warnbar}{HTML}{D68910}       %% warning left bar
\definecolor{rulegray}{HTML}{C0C8D0}      %% horizontal rule color
\definecolor{textgray}{HTML}{6B7280}      %% secondary text (headers, page nums)
\definecolor{chaphighlight}{HTML}{E8EEF7} %% chapter number background

%% Uppercase aliases (book class MakeUppercase uppercases color name arguments)
\colorlet{CHAPBLUE}{chapblue}
\colorlet{ACCENTRED}{accentred}
\colorlet{CODEBG}{codebg}
\colorlet{CODEBORDER}{codeborder}
\colorlet{CODEACCENT}{codeaccent}
\colorlet{NOTEBG}{notebg}
\colorlet{NOTEBAR}{notebar}
\colorlet{WARNBG}{warnbg}
\colorlet{WARNBAR}{warnbar}
\colorlet{RULEGRAY}{rulegray}
\colorlet{TEXTGRAY}{textgray}
\colorlet{CHAPHIGHLIGHT}{chaphighlight}

%% ─── Fonts ────────────────────────────────────────────────────────────────────
\setmainfont{IBM Plex Serif}[
  Path           = /usr/share/fonts/truetype/ibm-plex/,
  UprightFont    = IBMPlexSerif-Regular.ttf,
  BoldFont       = IBMPlexSerif-SemiBold.ttf,
  ItalicFont     = IBMPlexSerif-Italic.ttf,
  BoldItalicFont = IBMPlexSerif-SemiBoldItalic.ttf,
  Ligatures      = TeX
]
\setsansfont{IBM Plex Sans}[
  Path           = /usr/share/fonts/truetype/ibm-plex/,
  UprightFont    = IBMPlexSans-Regular.ttf,
  BoldFont       = IBMPlexSans-SemiBold.ttf,
  ItalicFont     = IBMPlexSans-Italic.ttf,
  BoldItalicFont = IBMPlexSans-SemiBoldItalic.ttf,
  Ligatures      = TeX
]
\setmonofont{IBM Plex Mono}[
  Path           = /usr/share/fonts/truetype/ibm-plex/,
  UprightFont    = IBMPlexMono-Regular.ttf,
  BoldFont       = IBMPlexMono-SemiBold.ttf,
  ItalicFont     = IBMPlexMono-Italic.ttf,
  BoldItalicFont = IBMPlexMono-SemiBoldItalic.ttf,
  Scale          = 0.85
]

%% ─── Paragraph spacing ────────────────────────────────────────────────────────
\setlength{\parindent}{0pt}
\setlength{\parskip}{7pt plus 2pt minus 1pt}
\setlength{\emergencystretch}{4em}
\sloppy

%% ─── Hyperlinks ───────────────────────────────────────────────────────────────
\hypersetup{
  hidelinks         = true,
  pdfborder         = {0 0 0},
  breaklinks        = true,
  pdftitle          = {$title$},
  pdfauthor         = {$author$},
  bookmarksnumbered = true,
  bookmarksopen     = true
}

%% Strip decoration from PDF bookmarks
\pdfstringdefDisableCommands{%
  \let\color\@gobble%
  \let\sffamily\relax%
  \let\bfseries\relax%
  \let\itshape\relax%
  \let\normalfont\relax%
  \let\Large\relax%
  \let\large\relax%
  \let\small\relax%
}

%% ─── Safe color helper for headings ──────────────────────────────────────────
\newcommand{\hcolor}[1]{\texorpdfstring{\color{#1}}{}}

%% ─── Section heading styles ──────────────────────────────────────────────────
%% Chapter: dramatic opener inspired by No Starch
\titleformat{\chapter}[display]
  {\normalfont\sffamily\bfseries}
  {%
    {\color{rulegray}\rule{\textwidth}{1pt}}\\[6pt]%
    {\small\sffamily\color{textgray}\MakeUppercase{Chapter}\ \thechapter}%
  }
  {6pt}
  {\Huge\color{chapblue}}
  [{\color{rulegray}\vspace{6pt}\rule{\textwidth}{1pt}}]

\titlespacing*{\chapter}{0pt}{0pt}{28pt}

%% Section
\titleformat{\section}
  {\sffamily\large\bfseries\hcolor{chapblue}}
  {\hcolor{chapblue}\thesection}
  {0.8em}
  {}

\titlespacing*{\section}{0pt}{20pt plus 4pt minus 2pt}{8pt plus 2pt}

%% Subsection
\titleformat{\subsection}
  {\sffamily\normalsize\bfseries\hcolor{chapblue}}
  {\hcolor{chapblue}\thesubsection}
  {0.7em}
  {}

\titlespacing*{\subsection}{0pt}{14pt plus 3pt minus 1pt}{5pt plus 1pt}

%% Subsubsection
\titleformat{\subsubsection}
  {\sffamily\small\bfseries}
  {}
  {0pt}
  {}

\titlespacing*{\subsubsection}{0pt}{10pt plus 2pt}{4pt}

%% ─── Table of contents ────────────────────────────────────────────────────────
\setlength{\cftbeforechapskip}{8pt}
\renewcommand{\cftchapfont}{\sffamily\bfseries}
\renewcommand{\cftchappagefont}{\sffamily\bfseries}
\renewcommand{\cftsecfont}{\sffamily\small}
\renewcommand{\cftsecpagefont}{\sffamily\small}
\setlength{\cftsecindent}{1.5em}
\renewcommand{\cftdotsep}{4}

%% ─── Headers and footers ─────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
%% Single-sided: chapter name on right of header, page number on right of footer
\fancyhead[R]{%
  \small\sffamily\color{textgray}%
  \nouppercase{\leftmark}%
}
\fancyhead[L]{%
  \small\sffamily\color{textgray}%
  \textit{$title$}%
}
\fancyfoot[C]{\small\sffamily\color{textgray}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{%
  \hbox to\headwidth{\color{rulegray}\leaders\hrule height \headrulewidth\hfill}%
}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\small\sffamily\color{textgray}\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

%% Suppress all-caps in chapter marks
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}

%% ─── Pandoc syntax highlighting ──────────────────────────────────────────────
$if(highlighting-macros)$
$highlighting-macros$
$endif$

%% Redefine Highlighting to enable line breaking (MUST come after above)
\RecustomVerbatimEnvironment{Highlighting}{Verbatim}{%
  commandchars=\\\{\},%
  fontsize=\small,%
  breaklines=true,%
  breakanywhere=true,%
  breaksymbolleft={\color{textgray}\tiny\ensuremath{\hookrightarrow}},%
  breaksymbolright={}%
}

%% Clean code block container (replaces pandoc's snugshade)
\renewenvironment{Shaded}{%
  \begin{mdframed}[%
    backgroundcolor=codebg,%
    linecolor=codeborder,%
    linewidth=0.6pt,%
    leftmargin=0pt,%
    rightmargin=0pt,%
    innerleftmargin=12pt,%
    innerrightmargin=12pt,%
    innertopmargin=8pt,%
    innerbottommargin=8pt,%
    skipabove=10pt,%
    skipbelow=8pt,%
    splitbottomskip=6pt,%
    splittopskip=6pt%
  ]%
}{%
  \end{mdframed}%
}

%% ─── Table styling ───────────────────────────────────────────────────────────
\renewcommand{\arraystretch}{1.4}
\setlength{\tabcolsep}{8pt}

%% Allow word breaks at / _ . in table cells (handles file paths)
\newcommand{\allowpathbreaks}{\emergencystretch=3em\sloppy}

%% Style longtables with booktabs-like rules and tighter font
\AtBeginEnvironment{longtable}{%
  \small\sffamily\allowpathbreaks%
  \setlength{\LTpre}{8pt}%
  \setlength{\LTpost}{8pt}%
}

%% ─── Callout boxes ───────────────────────────────────────────────────────────
\mdfdefinestyle{notestyle}{
  backgroundcolor  = notebg,
  linecolor        = notebar,
  linewidth        = 3pt,
  topline          = false,
  rightline        = false,
  bottomline       = false,
  leftline         = true,
  innerleftmargin  = 12pt,
  innerrightmargin = 10pt,
  innertopmargin   = 8pt,
  innerbottommargin= 8pt,
  skipabove        = 10pt,
  skipbelow        = 8pt,
}

\mdfdefinestyle{warningstyle}{
  backgroundcolor  = warnbg,
  linecolor        = warnbar,
  linewidth        = 3pt,
  topline          = false,
  rightline        = false,
  bottomline       = false,
  leftline         = true,
  innerleftmargin  = 12pt,
  innerrightmargin = 10pt,
  innertopmargin   = 8pt,
  innerbottommargin= 8pt,
  skipabove        = 10pt,
  skipbelow        = 8pt,
}

%% ─── Caption styling ─────────────────────────────────────────────────────────
\captionsetup{
  font       = {small, sf},
  labelfont  = {bf, color=chapblue},
  labelsep   = period,
  skip       = 6pt
}

%% ─── List styling ────────────────────────────────────────────────────────────
\setlist[itemize]{
  leftmargin = 1.5em,
  topsep     = 4pt,
  itemsep    = 2pt,
  parsep     = 0pt
}
\setlist[enumerate]{
  leftmargin = 1.75em,
  topsep     = 4pt,
  itemsep    = 2pt,
  parsep     = 0pt
}
\setlist[description]{
  font       = {\sffamily\bfseries},
  leftmargin = 1.5em,
  topsep     = 4pt,
  itemsep    = 2pt
}

%% ─── Inline code ─────────────────────────────────────────────────────────────
\let\OldTexttt\texttt
\renewcommand{\texttt}[1]{%
  {\small\ttfamily\color{chapblue}#1}%
}

%% ─── Utility commands ────────────────────────────────────────────────────────
\providecommand{\tightlist}{%
  \setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}}

\providecommand{\pandocbounded}[1]{#1}

%% ─── Title page ───────────────────────────────────────────────────────────────
\newcommand{\maketitlepage}{%
  \thispagestyle{empty}%
  \begin{titlepage}
    \vspace*{0.6in}
    {\color{rulegray}\rule{\textwidth}{1.5pt}}\par
    \vspace{3pt}
    {\color{chapblue}\rule{\textwidth}{6pt}}\par
    \vspace{0.5in}
    {\sffamily\fontsize{42}{48}\selectfont\bfseries\color{chapblue}$title$}\par
    \vspace{0.18in}
    $if(subtitle)$
    {\sffamily\Large\color{textgray}$subtitle$}\par
    \vspace{0.4in}
    $endif$
    \vfill
    {\color{chapblue}\rule{\textwidth}{4pt}}\par
    \vspace{3pt}
    {\color{rulegray}\rule{\textwidth}{1pt}}\par
    \vspace{0.25in}
    {\sffamily\large\bfseries\color{chapblue}$author$}\par
    \vspace{4pt}
    {\sffamily\normalsize\color{textgray}$date$}
  \end{titlepage}
  \cleardoublepage
}

%% ─── Begin document ──────────────────────────────────────────────────────────
\begin{document}

\frontmatter
\maketitlepage

$if(toc)$
{
  \hypersetup{hidelinks}
  \setcounter{tocdepth}{$toc-depth$}
  \tableofcontents
  \cleardoublepage
}
$endif$

\mainmatter

$body$

\end{document}
